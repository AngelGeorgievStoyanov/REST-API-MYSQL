{
  "name": "rest-api-mysql",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "server": "node --inspect=5858 -r ts-node/register/transpile-only ./src/index.ts",
    "start": "npx tsc && pm2 start ./build/index.js",
    "build": "tsc",
    "bild": "tsc",
    "dev": "nodemon",
    "migration:phase4": "ts-node src/migration/run-main.ts",
    "migration:phase4:dry-run": "ts-node src/migration/run-main.ts --dry-run",
    "migration:phase4:verify": "ts-node src/migration/run-main.ts --verify",
    "db:clone-test": "ts-node src/db/cloneTestDatabase.ts",
    "db:clone-test:dry-run": "ts-node src/db/cloneTestDatabase.ts --dry-run",
    "lint": "eslint .",
    "build:tests": "tsc --noEmitOnError false",
    "test:api": "node --test --test-concurrency=1 \"build/tests/*.test.js\""
  },
  "author": "Angel Stoyanov",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/body-parser": "^1.19.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "globals": "^16.5.0",
    "nodemon": "^3.1.14",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.2.0",
    "@prisma/client": "^6.19.3",
    "@types/bcrypt": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/mysql": "^2.15.21",
    "@types/nodemailer": "^6.4.7",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.8",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql": "^2.18.1",
    "nodemailer": "^10.0.13",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@prisma/client@6.19.3": true
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
